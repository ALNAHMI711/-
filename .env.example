# Copy to .env locally. NEVER commit real secrets.
APP_ENV=development
APP_NAME=Mashahid
APP_URL=http://localhost:8000

# Authentication
SESSION_SECRET=change-me
ADMIN_CONTROL_SECRET=change-me

# Database
DATABASE_URL=sqlite:///./data/app.db

# Shared OAuth/session coordination (production)
REDIS_URL=

# Optional integrations
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=

# OAuth placeholders
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
